# Hedera JSON-RPC endpoint used when forking (testnet default)
HEDERA_RPC_URL=https://testnet.hashio.io/api

# Don't fill manually. Run `yarn hardhat:account:generate` or `yarn hardhat:account:import`.
DEPLOYER_PRIVATE_KEY_ENCRYPTED=

# ── HydroREC setup (packages/hardhat/deploy/01_setup_hydro_rec.ts) ──────────
# Extra verifier to grant VERIFIER_ROLE (the deployer always has it). Use the EVM address of HEDERA_OPERATOR_KEY.
VERIFIER_ADDRESS=
# Operator of the demo plant; receives minted RECs. Defaults to the deployer.
PLANT_OPERATOR_ADDRESS=
# HBAR sent with createRecToken to cover the HTS token-creation fee; unused change can be swept with sweepHbar.
REC_TOKEN_CREATE_FEE_HBAR=20
# Oracle answers older than this (seconds) cannot settle purchases. Default 90000 (25 h) matches a 24 h heartbeat.
MAX_PRICE_AGE_SECONDS=
