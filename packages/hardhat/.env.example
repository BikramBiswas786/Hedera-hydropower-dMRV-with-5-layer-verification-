# Hedera JSON-RPC endpoint used when forking (testnet default)
HEDERA_RPC_URL=https://testnet.hashio.io/api

# Don't fill manually. Run `yarn hardhat:account:generate` or `yarn hardhat:account:import`.
DEPLOYER_PRIVATE_KEY_ENCRYPTED=

# ── Registry setup (packages/hardhat/deploy/01_setup_hydro_registry.ts) ──────
# The attesting server's key (EVM address of HEDERA_OPERATOR_KEY or VERIFIER_PRIVATE_KEY). When set, it gets
# VERIFIER_ROLE and the deployer loses it, so the server key can attest but never administer.
VERIFIER_ADDRESS=
# Registry admin after setup: EVM address or Hedera account id (0.0.<num>). Use an account with a threshold key
# (e.g. 2 of 3) so registering plants or swapping meters needs several signers. The deployer then renounces admin.
ADMIN_ADDRESS=
# Operator of the demo plants; receives minted credits. Defaults to the deployer.
PLANT_OPERATOR_ADDRESS=
# HBAR sent with createCreditToken to cover the HTS token-creation fee; unused change can be swept with sweepHbar.
CREDIT_TOKEN_CREATE_FEE_HBAR=20
# Same for the retirement-certificate NFT collection (createCertificateToken).
CERTIFICATE_TOKEN_CREATE_FEE_HBAR=20
# Fresh Chainlink and Supra answers must agree within this many basis points (default 300 = 3%).
MAX_ORACLE_DEVIATION_BPS=
# Oracle answers older than this (seconds) cannot settle purchases. Default 90000 (25 h) matches a 24 h heartbeat.
MAX_PRICE_AGE_SECONDS=
