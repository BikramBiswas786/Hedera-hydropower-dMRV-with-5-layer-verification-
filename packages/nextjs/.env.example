# Copy to .env.local. Nothing here is required to browse the app or run the verifier;
# the server variables below only enable publishing (HCS + submitAttestation).

# ── Public (inlined into the browser bundle) ──────────────────────────────────
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
NEXT_PUBLIC_HEDERA_MAINNET_RPC_URL=
NEXT_PUBLIC_HEDERA_TESTNET_RPC_URL=
# Defaults to https://<testnet|mainnet>.mirrornode.hedera.com for the first target network
NEXT_PUBLIC_MIRROR_NODE_URL=

# ── Server only: verifier / publisher ────────────────────────────────────────
# Hedera account that pays for and signs HCS messages, e.g. 0.0.1234567
HEDERA_OPERATOR_ID=
# Its private key (hex or DER). Use an ECDSA key: its EVM address is then the verifier that must hold VERIFIER_ROLE.
HEDERA_OPERATOR_KEY=
# Audit topic created by `yarn mrv:create-topic`, e.g. 0.0.7654321
HCS_TOPIC_ID=
# Only needed if the verifier EVM key differs from HEDERA_OPERATOR_KEY (e.g. ED25519 operator, or a local chain)
VERIFIER_PRIVATE_KEY=
# Shared secret for POST /api/mrv/attest and the MCP submit_attestation tool. Unset = writes disabled.
MRV_API_KEY=

# ── Server only: Guardian bridge (docs/GUARDIAN.md) ───────────────────────────
# Ed25519 key that signs cross-check result VCs (DER or raw hex). Create and publish with `yarn guardian:publish-did`.
BRIDGE_ED25519_PRIVATE_KEY=
# The key's DID, printed by `yarn guardian:publish-did --send`: did:hedera:<network>:<base58(sha256(pubkey))>_<topic>
BRIDGE_DID=
# Bearer token the Guardian httpRequestBlock sends ("Include value in exported policy" unchecked). Unset = 503.
GUARDIAN_BRIDGE_API_KEY=
# The imported "DMRV Cross-Check Result" schema: {"type":"<uuid>&<version>","contextUrl":"ipfs://<cid>"}
# (draft/dry run: {"type":"<uuid>","contextUrl":"schema:<uuid>"}), or {"<policyId>": {...}, "default": {...}}
GUARDIAN_BRIDGE_RESULT_SCHEMA=
# Evidence verifier: policy/instance topics to accept by default (comma-separated), mirror node and IPFS gateway
GUARDIAN_EVIDENCE_TOPIC_IDS=
# Defaults to NEXT_PUBLIC_MIRROR_NODE_URL / the network's public mirror node
GUARDIAN_MIRROR_NODE_URL=
# Guardian's IPFS_PUBLIC_GATEWAY convention; default https://ipfs.io/ipfs/{cid}
GUARDIAN_IPFS_GATEWAY=
# Only for `yarn guardian:publish-did --send`: Filebase bucket token for the IPFS RPC API (pins the DID document)
FILEBASE_IPFS_RPC_TOKEN=
# Optional for the script: testnet (default) | mainnet, and an existing topic to reuse
HEDERA_NETWORK=
BRIDGE_DID_TOPIC_ID=
