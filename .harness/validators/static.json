      "packages/hardhat/test/UsdCheckout.test.ts",
      "packages/hardhat/test/LocalDemo.test.ts",
      "packages/hardhat/deploy/03_seed_local_demo.ts",
      "packages/hardhat/utils/localSaucer.ts"
    ],
    "forbidden": [
      ".env",
      "packages/nextjs/.env",
      "packages/nextjs/.env.local",
      "packages/hardhat/.env",
      "packages/foundry"
    ]
  },
  "textAssertions": [
    {
      "file": "README.md",
      "contains": [
        "yarn install",
        "yarn deploy --network localhost",
        "yarn deploy --network hederaTestnet",
        "yarn mrv:record",
        "/api/mcp",
        "reproduce_attestation",
        "Supra",
        "SaucerSwap",
        "UsdCheckout",
        "ER = BE − PE − LE",
        "HEDERA_FACTS.md"
      ]
    },
    {
      "file": "AGENTS.md",
      "contains": [
        "yarn test",
        "NATIVE_UNITS_PER_HBAR",
        "1 token = 1 t CO2e",
        "quantify.ts"
      ]
    },
    {
      "file": "packages/hardhat/contracts/DmrvRegistry.sol",
      "contains": [
        "HederaTokenLib.mint",
        "HederaTokenLib.burn",
        "HederaTokenLib.mintNft",
        "StaleLedger",
        "VALIDATION_APPROVAL_TYPEHASH",
        "VERIFICATION_STATEMENT_TYPEHASH",
        "function recordMonitoring",
        "function verifyPeriod",
        "evidenceUsed"
      ]
    },
    {
      "file": "packages/hardhat/contracts/modules/HydroVmr0017Module.sol",
      "contains": [
        "PowerDensityTooLow",
        "RESERVOIR_EF_G_PER_MWH",
        "RenewalSpan"
      ]
    },
    {
      "file": "packages/hardhat/contracts/CreditMarket.sol",
      "contains": [
        "UsdSettlement",
        "buyAndRetire",
        "REGISTRY.retireFor"
      ]
    },
    {
      "file": "packages/hardhat/contracts/ResilientHbarUsdFeed.sol",
      "contains": [
        "PriceSourcesDisagree",
        "NoFreshPrice",
        "ISupraSValueFeed"
      ]
    },
    {
      "file": "packages/hardhat/contracts/settlement/UsdSettlement.sol",
      "contains": [
        "AggregatorV3Interface",
        "ISaucerFactory",
        "PoolPriceDeviation",
        "swapExactETHForTokens"
      ]
    },
    {
      "file": "packages/hardhat/contracts/UsdCheckout.sol",
      "contains": [
        "HederaTokenLib.associateSelf",
        "HederaTokenLib.transferFrom",
        "UsdSettlement"
      ]
    },
    {
      "file": "AGENTS.md",
      "contains": [
        "HEDERA_FACTS.md",
        "Recipe: add a methodology"
      ]
    }
  ]
}
