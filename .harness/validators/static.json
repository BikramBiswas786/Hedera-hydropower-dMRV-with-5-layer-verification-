      "packages/hardhat/test/CreditMarket.test.ts",
      "packages/hardhat/test/ContractSize.test.ts",
      "packages/hardhat/scripts/checkContractSizes.ts",
      "packages/nextjs/services/mrv/approval.ts",
      "packages/nextjs/services/mrv/fixtures/eip712.json",
