{
  "name": "hydro-dmrv-static",
  "description": "Structural invariants of the Hydro dMRV template.",
  "jsonAssertions": [
    {
      "file": "package.json",
      "path": "packageManager",
      "equals": "yarn@3.2.3"
    },
    {
      "file": "template.json",
      "path": "name",
      "equals": "hydro-dmrv"
    }
  ],
  "fileAssertions": {
    "required": [
      "README.md",
      "AGENTS.md",
      "LICENCE",
      "template.json",
      "packages/hardhat/contracts/HydroCreditRegistry.sol",
      "packages/hardhat/contracts/lib/HederaTokenLib.sol",
      "packages/hardhat/test/HydroCreditRegistry.test.ts",
      "packages/nextjs/services/mrv/engine.ts",
      "packages/nextjs/services/mrv/engine.test.ts",
      "packages/nextjs/app/api/mcp/route.ts",
      "packages/nextjs/app/verify/page.tsx",
      "packages/nextjs/app/market/page.tsx",
      "packages/nextjs/app/audit/page.tsx",
      "packages/hardhat/contracts/ResilientHbarUsdFeed.sol",
      "packages/hardhat/test/ResilientHbarUsdFeed.test.ts",
      "packages/nextjs/services/mrv/audit.test.ts",
      "packages/nextjs/services/mrv/report.test.ts",
      "packages/nextjs/app/certificate/[id]/page.tsx",
      "packages/nextjs/public/llms.txt",
      "packages/nextjs/.env.example",
      "packages/hardhat/.env.example",
      "packages/nextjs/services/mrv/methodology/tool07.ts",
      "packages/nextjs/services/mrv/methodology/quantify.ts",
      "packages/hardhat/test/fixtures/quantificationVectors.ts",
      "packages/nextjs/app/methodology/page.tsx",
      "packages/nextjs/app/plants/page.tsx",
      "packages/nextjs/app/portfolio/page.tsx",
      "packages/nextjs/app/guide/page.tsx",
      "packages/nextjs/services/mrv/provenance.ts",
      "packages/nextjs/services/mrv/provenance.test.ts"
    ],
    "forbidden": [
      ".env",
      "packages/nextjs/.env",
      "packages/nextjs/.env.local",
      "packages/hardhat/.env",
      "packages/foundry"
    ]
  },
  "textAssertions": [
    {
      "file": "README.md",
      "contains": [
        "yarn install",
        "yarn deploy --network hederaTestnet",
        "yarn mrv:attest",
        "/api/mcp",
        "reproduce_attestation",
        "Supra",
        "ER = BE − PE − LE",
        "TOOL07"
      ]
    },
    {
      "file": "AGENTS.md",
      "contains": [
        "yarn test",
        "NATIVE_UNITS_PER_HBAR",
        "1 token = 1 t CO2e",
        "quantify.ts"
      ]
    },
    {
      "file": "packages/hardhat/contracts/HydroCreditRegistry.sol",
      "contains": [
        "AggregatorV3Interface",
        "HederaTokenLib.mint",
        "HederaTokenLib.burn",
        "HederaTokenLib.mintNft",
        "PowerDensityTooLow",
        "RESERVOIR_EF_G_PER_MWH",
        "StaleLedger"
      ]
    },
    {
      "file": "packages/hardhat/contracts/ResilientHbarUsdFeed.sol",
      "contains": [
        "PriceSourcesDisagree",
        "NoFreshPrice",
        "ISupraSValueFeed"
      ]
    }
  ]
}
